# Copy to .env and set as needed. Desktop (Electron) loads .env from project root.
# See docs/DESKTOP_ENV.md for full reference.

# --- Desktop (required or default) ---
# EXPLORER_URL=http://localhost:3000/tools/api-signal-explorer
# MITM_PROXY=http://127.0.0.1:8080
# BRIDGE_WS=ws://localhost:8787/explorer

# --- Bridge (when running npm run mitm:bridge) ---
# BRIDGE_PORT=8787

# --- mitmproxy stream_ws (Python) ---
# MITM_WS_URL=ws://127.0.0.1:8787/mitm

# --- Deep Recon (optional) ---
# DEEP_RECON_ASAR_BASELINE=
# DEEP_RECON_HALT_ON_FAIL=
# DEEP_RECON_MEASURE_TEXT_NATIVE=

# --- AI / LLM API Keys ---
OPENAI_API_KEY=your-openai-api-key-here
