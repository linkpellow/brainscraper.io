# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# cache files
.cache/
*.cache

# Keep geo ID database in version control (it's valuable data)
# data/geo-id-database.json is tracked
# But ignore CSV exports
data/*.csv

# API results (large files, auto-saved for cost efficiency)
data/api-results/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# credential harvest outputs (security)
harvested-*.json
extracted-tokens.json

# stub for Cursor context script (avoids "no such file: #!/usr/bin/env")
/#!/

# Electron Explorer desktop
/electron-explorer/node_modules/
/electron-explorer/main.js

# Desktop (Octoparse-style API Signal Explorer)
/desktop/node_modules/
/desktop/main.js
/desktop/preload-browser.js
/desktop/native-mac/build/
/desktop/native-mac/node_modules/

# Neural bridge (src/main) build
/dist/

